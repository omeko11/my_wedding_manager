# ==============================================================================
# MY WEDDING MANAGER - ENVIRONMENT CONFIGURATION (.env.example)
# Copy this file to .env.local for local development or set in Vercel Dashboard
# ==============================================================================

# 1. ENVIRONMENT MODE ('development' | 'production')
NEXT_PUBLIC_APP_ENV=production

# 2. SERVER-SIDE AUTHENTICATION & SESSION SIGNING SECRET (REQUIRED IN PRODUCTION)
# Generate a strong random string (e.g. `openssl rand -hex 32`)
AUTH_SECRET=ganti_dengan_random_secret_key_minimal_32_karakter_2026

# 3. PRIMARY ADMIN CREDENTIALS (SERVER-SIDE ONLY - NEVER EXPOSED TO CLIENT)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@wedding.id
ADMIN_NAME=Administrator Utama
ADMIN_PASSWORD=WeddingAdmin#2026
